def cmd_download(args: argparse.Namespace) -> int:
    payload = {"repo": args.repo}
    if args.file:
        payload["filename"] = args.file
    result = _hit_post(args, "/api/models/download", body=payload, timeout=30.0)
    if not args.wait:
        _ok(result)
        return 0
    deadline = time.time() + args.timeout
    last_pct = -1
    while time.time() < deadline:
        status = _hit_get(args, "/api/models/download/status", timeout=10.0)
        match = next((s for s in status.get("downloads", []) if s.get("repo") == args.repo), None)
        if not match:
            time.sleep(2)
            continue
        pct = int(match.get("progress", 0) * 100)
        if pct != last_pct:
            print(f"[download] {pct}% {match.get('state')}", file=sys.stderr, flush=True)
            last_pct = pct
        if match.get("state") in {"completed", "failed", "cancelled"}:
            _ok(match)
            return 0 if match.get("state") == "completed" else 1
        time.sleep(2)
    _die("download timed out")
    return 1


def cmd_download_status(args: argparse.Namespace) -> int:
    _ok(_hit_get(args, "/api/models/download/status", timeout=10.0))
    return 0


def cmd_download_cancel(args: argparse.Namespace) -> int:
