    sub.add_parser("tools-list").set_defaults(func=cmd_tools_list)
    sub.add_parser("adapters-list").set_defaults(func=cmd_adapters_list)
    sub.add_parser("finetuning-status").set_defaults(func=cmd_finetuning_status)
    s = sub.add_parser("finetuning-start"); s.add_argument("--body", default=None); s.add_argument("--file", default=None); s.add_argument("--timeout", type=float, default=60.0); s.set_defaults(func=cmd_finetuning_start)
    sub.add_parser("auth-session").set_defaults(func=cmd_auth_session)

    # -- HTML Challenges --
    sub.add_parser("challenges-list").set_defaults(func=cmd_challenges_list)
    s = sub.add_parser("challenges-get"); s.add_argument("challenge_id"); s.set_defaults(func=cmd_challenges_get)
    s = sub.add_parser("challenges-file"); s.add_argument("challenge_id"); s.add_argument("slot_id"); s.add_argument("--out", default=None); s.set_defaults(func=cmd_challenges_file)
    s = sub.add_parser("challenges-create"); s.add_argument("--body", default=None); s.add_argument("--file", default=None); s.add_argument("--timeout", type=float, default=1800.0); s.set_defaults(func=cmd_challenges_create)
    s = sub.add_parser("challenges-open-file")
    s.add_argument("path_arg", metavar="path", nargs="?", default=None)
    s.add_argument("--body", default=None); s.add_argument("--file", default=None); s.set_defaults(func=cmd_challenges_open_file)
    s = sub.add_parser("challenges-repair")
    s.add_argument("challenge_id"); s.add_argument("slot_id")
    s.add_argument("--body", default=None); s.add_argument("--file", default=None)
    s.add_argument("--timeout", type=float, default=1800.0); s.set_defaults(func=cmd_challenges_repair)
    s = sub.add_parser("challenges-retry")
    s.add_argument("challenge_id"); s.add_argument("slot_id")
    s.add_argument("--body", default=None); s.add_argument("--file", default=None)
    s.add_argument("--timeout", type=float, default=1800.0); s.set_defaults(func=cmd_challenges_retry)
    s = sub.add_parser("challenges-validate")
    s.add_argument("challenge_id"); s.add_argument("slot_id")
    s.add_argument("--body", default=None); s.add_argument("--file", default=None); s.set_defaults(func=cmd_challenges_validate)
    s = sub.add_parser("challenges-delete"); s.add_argument("challenge_id"); s.set_defaults(func=cmd_challenges_delete)

    # -- Image / video download lifecycle --
    s = sub.add_parser("image-download"); s.add_argument("repo"); s.add_argument("--file", default=None); s.set_defaults(func=cmd_image_download)
    sub.add_parser("image-download-status").set_defaults(func=cmd_image_download_status)
    s = sub.add_parser("image-download-cancel"); s.add_argument("repo"); s.set_defaults(func=cmd_image_download_cancel)
    s = sub.add_parser("image-download-delete"); s.add_argument("repo"); s.set_defaults(func=cmd_image_download_delete)
    s = sub.add_parser("video-download"); s.add_argument("repo"); s.add_argument("--file", default=None); s.set_defaults(func=cmd_video_download)
