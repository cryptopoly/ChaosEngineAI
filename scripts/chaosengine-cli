    s.add_argument("session_id"); s.add_argument("--message-index", type=int, required=True, dest="message_index")
    s.add_argument("--ref", required=True); s.add_argument("--name", default=None)
    s.add_argument("--max-tokens", type=int, default=2048); s.add_argument("--temperature", type=float, default=0.7)
