    s = sub.add_parser("session-documents"); s.add_argument("session_id"); s.set_defaults(func=cmd_session_documents)
    s = sub.add_parser("compare", help="Side-by-side chat comparison (full payload required).")
    s.add_argument("--body", default=None); s.add_argument("--file", default=None)
    s.add_argument("--timeout", type=float, default=600.0); s.set_defaults(func=cmd_compare)

    # -- Server --
    sub.add_parser("server-status").set_defaults(func=cmd_server_status)
    sub.add_parser("server-shutdown").set_defaults(func=cmd_server_shutdown)
    s = sub.add_parser("server-logs", help="Stream server log events.")
    s.add_argument("--timeout", type=float, default=3600.0); s.set_defaults(func=cmd_server_logs)

    # -- Image --
    s = sub.add_parser("image-generate")
    s.add_argument("prompt", nargs="?", default=None)
    s.add_argument("--model", default=None); s.add_argument("--steps", type=int, default=None)
    s.add_argument("--width", type=int, default=None); s.add_argument("--height", type=int, default=None)
    s.add_argument("--guidance", type=float, default=None); s.add_argument("--seed", type=int, default=None)
    s.add_argument("--negative", default=None)
    s.add_argument("--body", default=None); s.add_argument("--file", default=None)
    s.add_argument("--stream", action="store_true"); s.add_argument("--timeout", type=float, default=600.0)
    s.set_defaults(func=cmd_image_generate)
    sub.add_parser("image-progress").set_defaults(func=cmd_image_progress)
    sub.add_parser("image-cancel").set_defaults(func=cmd_image_cancel)
    sub.add_parser("image-outputs").set_defaults(func=cmd_image_outputs)
    sub.add_parser("image-runtime").set_defaults(func=cmd_image_runtime)
    sub.add_parser("image-unload").set_defaults(func=cmd_image_unload)
    sub.add_parser("image-library").set_defaults(func=cmd_image_library)
    sub.add_parser("image-catalog").set_defaults(func=cmd_image_catalog)

    # -- Video --
    s = sub.add_parser("video-generate")
    s.add_argument("prompt", nargs="?", default=None)
    s.add_argument("--model", default=None); s.add_argument("--steps", type=int, default=None)
    s.add_argument("--width", type=int, default=None); s.add_argument("--height", type=int, default=None)
    s.add_argument("--frames", type=int, default=None); s.add_argument("--fps", type=int, default=None)
    s.add_argument("--guidance", type=float, default=None); s.add_argument("--seed", type=int, default=None)
    s.add_argument("--negative", default=None)
    s.add_argument("--body", default=None); s.add_argument("--file", default=None)
    s.add_argument("--timeout", type=float, default=1800.0)
    s.set_defaults(func=cmd_video_generate)
    sub.add_parser("video-progress").set_defaults(func=cmd_video_progress)
    sub.add_parser("video-cancel").set_defaults(func=cmd_video_cancel)
    sub.add_parser("video-outputs").set_defaults(func=cmd_video_outputs)
    sub.add_parser("video-runtime").set_defaults(func=cmd_video_runtime)
    sub.add_parser("video-library").set_defaults(func=cmd_video_library)
    sub.add_parser("video-catalog").set_defaults(func=cmd_video_catalog)

    # -- Setup --
    s = sub.add_parser("mtplx-install"); s.add_argument("--wait", action="store_true"); s.add_argument("--timeout", type=float, default=600.0); s.set_defaults(func=cmd_mtplx_install)
    sub.add_parser("mtplx-status").set_defaults(func=cmd_mtplx_status)
    s = sub.add_parser("longlive-install"); s.add_argument("--wait", action="store_true"); s.add_argument("--timeout", type=float, default=1800.0); s.set_defaults(func=cmd_longlive_install)
    sub.add_parser("longlive-status").set_defaults(func=cmd_longlive_status)
    s = sub.add_parser("wan-install"); s.add_argument("--repo", default=None); s.add_argument("--wait", action="store_true"); s.add_argument("--timeout", type=float, default=3600.0); s.set_defaults(func=cmd_wan_install)
    sub.add_parser("wan-status").set_defaults(func=cmd_wan_status)
    sub.add_parser("wan-inventory").set_defaults(func=cmd_wan_inventory)
    s = sub.add_parser("cuda-torch-install"); s.add_argument("--wait", action="store_true"); s.add_argument("--timeout", type=float, default=1800.0); s.set_defaults(func=cmd_cuda_torch_install)
    s = sub.add_parser("gpu-bundle-install"); s.add_argument("--wait", action="store_true"); s.add_argument("--timeout", type=float, default=1800.0); s.set_defaults(func=cmd_gpu_bundle_install)
    sub.add_parser("gpu-bundle-status").set_defaults(func=cmd_gpu_bundle_status)
    sub.add_parser("gpu-bundle-info").set_defaults(func=cmd_gpu_bundle_info)
    s = sub.add_parser("setup-install-package", help="Install a pip package via the setup endpoint.")
    s.add_argument("package"); s.add_argument("--extra-index", default=None); s.add_argument("--timeout", type=float, default=1800.0); s.set_defaults(func=cmd_setup_install_package)
    s = sub.add_parser("setup-install-system-package")
    s.add_argument("package"); s.add_argument("--timeout", type=float, default=1800.0); s.set_defaults(func=cmd_setup_install_system_package)
    sub.add_parser("setup-refresh").set_defaults(func=cmd_setup_refresh)
    sub.add_parser("turbo-update-check").set_defaults(func=cmd_turbo_update_check)

