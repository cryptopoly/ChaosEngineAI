#!/usr/bin/env python3
"""ChaosEngineAI CLI — full-surface automation wrapper over the FastAPI backend.

Two layers:

  1. ``call`` — generic HTTP dispatcher. Hits any registered route.
     Covers 100% of the backend surface; every endpoint reachable.
     ``chaosengine-cli call GET /api/health``
     ``chaosengine-cli call POST /api/models/load --body '{"modelRef":"..."}'``

  2. Typed shortcuts — ergonomic subcommands for common workflows:
     load / unload / prompt / bench / status / mtplx-install / mtplx-status
     download / convert / search / hub-search / list-weights
     session-create / session-delete / session-fork / session-variant
     server-start / server-stop / server-status / server-logs
     image-generate / image-progress / image-cancel / image-outputs
     video-generate / video-progress / video-cancel / video-outputs
     setup-install / setup-refresh / longlive-install / wan-install
     cuda-torch-install / gpu-bundle-install / turbo-update-check
     diagnostics-snapshot / diagnostics-log-tail / diagnostics-reextract
     gpu-status / cache-preview / prompts-list / prompts-enhance
     settings-get / settings-patch / workspaces-list
     plugins-list / plugins-enable / plugins-disable / tools-list / adapters-list
     finetuning-start / finetuning-status / metrics-gpu / compare
     routes / openapi

All structured output → stdout as JSON (composable with ``jq``); errors → stderr.
Exit 0 on success, non-zero on failure.

Examples:
    scripts/chaosengine-cli serve &
    scripts/chaosengine-cli routes --filter /api/images
    scripts/chaosengine-cli status | jq .runtime.state
    scripts/chaosengine-cli load Youssofal/Qwen3.6-27B-MTPLX-Optimized-Speed --spec
    scripts/chaosengine-cli prompt "hi" --stream --metrics
    scripts/chaosengine-cli image-generate "neon city skyline" --model FLUX.1-schnell --steps 4
    scripts/chaosengine-cli call POST /api/setup/install-package --body '{"package":"sageattention"}'
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any


_DEFAULT_HOST = os.environ.get("CHAOSENGINE_HOST", "127.0.0.1")
_DEFAULT_PORT = int(os.environ.get("CHAOSENGINE_PORT", "8876"))
_REPO_ROOT = Path(__file__).resolve().parents[1]


# ---------------------------------------------------------------------------
# Low-level HTTP helpers
# ---------------------------------------------------------------------------


def _base_url(args: argparse.Namespace) -> str:
    return f"http://{args.host}:{args.port}"


def _request(
    method: str,
    url: str,
    *,
    body: Any = None,
    timeout: float = 30.0,
    raw_body: bytes | None = None,
    content_type: str = "application/json",
) -> tuple[int, dict[str, Any] | str]:
    """One-shot HTTP. Returns (status_code, parsed_json_or_text).

    Status 0 indicates a network-level failure (returns error string).
    """
    if raw_body is not None:
        data = raw_body
        headers = {"Content-Type": content_type}
    elif body is not None:
        data = json.dumps(body).encode("utf-8")
        headers = {"Content-Type": "application/json"}
    else:
        data = None
        headers = {}
    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            status = resp.status
    except urllib.error.HTTPError as exc:
        raw = exc.read().decode("utf-8", errors="replace")
        status = exc.code
    except urllib.error.URLError as exc:
        return 0, str(exc.reason)
    try:
        return status, json.loads(raw)
    except json.JSONDecodeError:
        return status, raw


def _stream(url: str, body: dict[str, Any] | None, *, method: str = "POST", timeout: float = 600.0):
    """Yield each ``data: {...}`` JSON event from an SSE endpoint."""
    data = json.dumps(body).encode("utf-8") if body is not None else None
    headers = {"Content-Type": "application/json", "Accept": "text/event-stream"}
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        for raw in resp:
            line = raw.decode("utf-8", errors="replace")
            if not line.startswith("data: "):
                continue
            payload = line[len("data: ") :].strip()
            if payload == "[DONE]":
                break
            try:
                yield json.loads(payload)
            except json.JSONDecodeError:
                continue


def _die(msg: str, *, code: int = 1) -> None:
    print(json.dumps({"error": msg}), file=sys.stderr)
    sys.exit(code)


def _ok(payload: Any) -> None:
    sys.stdout.write(json.dumps(payload, indent=2, default=str))
    sys.stdout.write("\n")
    sys.stdout.flush()


def _load_body_arg(body_str: str | None, file_path: str | None) -> Any:
    """Resolve --body / --file precedence. ``--file -`` reads stdin."""
    if body_str and file_path:
        _die("--body and --file are mutually exclusive")
    if file_path:
        if file_path == "-":
            return json.loads(sys.stdin.read())
        return json.loads(Path(file_path).read_text())
    if body_str:
        return json.loads(body_str)
    return None


def _parse_query(pairs: list[str] | None) -> str:
    if not pairs:
        return ""
    parsed: list[tuple[str, str]] = []
    for pair in pairs:
        if "=" not in pair:
            _die(f"--query expects key=value, got: {pair}")
        key, value = pair.split("=", 1)
        parsed.append((key, value))
    return "?" + urllib.parse.urlencode(parsed)


# ---------------------------------------------------------------------------
# Generic dispatcher
# ---------------------------------------------------------------------------


def cmd_call(args: argparse.Namespace) -> int:
    """Generic HTTP dispatcher — every backend route reachable through this."""
    body = _load_body_arg(args.body, args.file)
    query = _parse_query(args.query)
    url = f"{_base_url(args)}{args.path}{query}"
    if args.stream:
        for event in _stream(url, body, method=args.method.upper(), timeout=args.timeout):
            sys.stdout.write(json.dumps(event) + "\n")
            sys.stdout.flush()
        return 0
    code, payload = _request(args.method.upper(), url, body=body, timeout=args.timeout)
    if code == 0:
        _die(f"network error: {payload}")
    if code >= 400:
        _die(f"HTTP {code}: {payload}", code=2)
    _ok(payload)
    return 0


def cmd_routes(args: argparse.Namespace) -> int:
    """List backend routes from /openapi.json. Optionally filter by prefix / method."""
    code, schema = _request("GET", f"{_base_url(args)}/openapi.json", timeout=10.0)
    if code != 200 or not isinstance(schema, dict):
        _die(f"openapi fetch failed: {schema}")
    rows: list[dict[str, str]] = []
    for path, ops in schema.get("paths", {}).items():
        if args.filter and not path.startswith(args.filter):
            continue
        for method, op in ops.items():
            if method.upper() not in {"GET", "POST", "PUT", "DELETE", "PATCH"}:
                continue
            if args.method and method.upper() != args.method.upper():
                continue
            rows.append({
                "method": method.upper(),
                "path": path,
                "summary": (op.get("summary") or "").strip(),
                "operationId": op.get("operationId", ""),
            })
    rows.sort(key=lambda r: (r["path"], r["method"]))
    _ok({"count": len(rows), "routes": rows})
    return 0


def cmd_openapi(args: argparse.Namespace) -> int:
    code, schema = _request("GET", f"{_base_url(args)}/openapi.json", timeout=10.0)
    if code != 200:
        _die(f"openapi fetch failed: {schema}")
    _ok(schema)
    return 0


def cmd_serve(args: argparse.Namespace) -> int:
    """Foreground backend. Exits when the server exits."""
    env = os.environ.copy()
    env["CHAOSENGINE_PORT"] = str(args.port)
    env["CHAOSENGINE_HOST"] = args.host
    cmd = [sys.executable, "-m", "backend_service.app"]
    print(f"[chaosengine-cli] serving on http://{args.host}:{args.port}", flush=True)
    proc = subprocess.Popen(cmd, cwd=str(_REPO_ROOT), env=env)
    try:
        return proc.wait()
    except KeyboardInterrupt:
        proc.terminate()
        try:
            proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            proc.kill()
        return 0


# ---------------------------------------------------------------------------
# Typed shortcut helpers
# ---------------------------------------------------------------------------


def _hit_get(args: argparse.Namespace, path: str, *, timeout: float = 30.0) -> dict[str, Any]:
    code, payload = _request("GET", f"{_base_url(args)}{path}", timeout=timeout)
    if code != 200:
        _die(f"GET {path} failed (HTTP {code}): {payload}")
    return payload if isinstance(payload, dict) else {"value": payload}


def _hit_post(args: argparse.Namespace, path: str, body: Any = None, *, timeout: float = 60.0) -> dict[str, Any]:
    code, payload = _request("POST", f"{_base_url(args)}{path}", body=body, timeout=timeout)
    if code != 200:
        _die(f"POST {path} failed (HTTP {code}): {payload}")
    return payload if isinstance(payload, dict) else {"value": payload}


# ---------------------------------------------------------------------------
# Runtime / status / health
# ---------------------------------------------------------------------------


def cmd_status(args: argparse.Namespace) -> int:
    workspace = _hit_get(args, "/api/workspace", timeout=10.0)
    runtime = workspace.get("runtime") or {}
    system = workspace.get("system") or {}
    snapshot = {
        "runtime": {
            "state": runtime.get("state"),
            "engine": runtime.get("engine"),
            "loadedModel": runtime.get("loadedModel"),
            "runtimeNote": runtime.get("runtimeNote"),
        },
        "system": {
            "platform": system.get("platform"),
            "arch": system.get("arch"),
            "totalMemoryGb": system.get("totalMemoryGb"),
            "availableMemoryGb": system.get("availableMemoryGb"),
            "mtplx": system.get("mtplx"),
            "dflash": system.get("dflash"),
        },
        "libraryCount": len(workspace.get("library") or []),
    }
    _ok(snapshot)
    return 0


def cmd_health(args: argparse.Namespace) -> int:
    _ok(_hit_get(args, "/api/health", timeout=5.0))
    return 0


def cmd_runtime(args: argparse.Namespace) -> int:
    _ok(_hit_get(args, "/api/runtime", timeout=10.0))
    return 0


# ---------------------------------------------------------------------------
# Model lifecycle
# ---------------------------------------------------------------------------


def cmd_load(args: argparse.Namespace) -> int:
    payload: dict[str, Any] = {
        "modelRef": args.ref,
        "backend": args.backend,
        "cacheStrategy": args.cache_strategy,
        "contextTokens": args.context,
        "speculativeDecoding": args.spec,
    }
    if args.path:
        payload["path"] = args.path
    if args.cache_bits is not None:
        payload["cacheBits"] = args.cache_bits
    if args.canonical_repo:
        payload["canonicalRepo"] = args.canonical_repo
    if args.fused_attention:
        payload["fusedAttention"] = True
    if args.tree_budget is not None:
        payload["treeBudget"] = args.tree_budget
    if args.fp16_layers is not None:
        payload["fp16Layers"] = args.fp16_layers

    code, body = _request("POST", f"{_base_url(args)}/api/models/load", body=payload, timeout=args.timeout)
    if code != 200:
        _die(f"load failed (HTTP {code}): {body}")
    runtime = (body or {}).get("runtime", {}) if isinstance(body, dict) else {}
    loaded = runtime.get("loadedModel") or {}
    _ok({
        "state": runtime.get("state"),
        "engine": runtime.get("engine"),
        "loadedRef": loaded.get("ref"),
        "loadedPath": loaded.get("path"),
        "runtimeNote": runtime.get("runtimeNote"),
        "speculativeDecoding": loaded.get("speculativeDecoding"),
    })
    return 0


def cmd_unload(args: argparse.Namespace) -> int:
    body = {"ref": args.ref} if args.ref else None
    payload = _hit_post(args, "/api/models/unload", body=body, timeout=30.0)
    _ok({"state": payload.get("runtime", {}).get("state")})
    return 0


