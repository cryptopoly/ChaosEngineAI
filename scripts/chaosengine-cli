    _ok(_hit_get(args, f"/api/chat/html-challenges/{args.challenge_id}", timeout=15.0))
    return 0


def cmd_challenges_file(args: argparse.Namespace) -> int:
    """Slot artefact file — returns raw bytes when --out is given, else JSON metadata."""
    url = f"{_base_url(args)}/api/chat/html-challenges/{args.challenge_id}/files/{args.slot_id}"
    req = urllib.request.Request(url, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=30.0) as resp:
            data = resp.read()
            content_type = resp.headers.get("Content-Type", "")
    except urllib.error.HTTPError as exc:
        _die(f"challenges-file failed (HTTP {exc.code}): {exc.read().decode('utf-8', errors='replace')}")
    if args.out:
        Path(args.out).write_bytes(data)
        _ok({"savedTo": args.out, "bytes": len(data), "contentType": content_type})
    elif content_type.startswith("application/json"):
        _ok(json.loads(data))
    else:
        sys.stdout.buffer.write(data)
    return 0


def cmd_challenges_create(args: argparse.Namespace) -> int:
    body = _load_body_arg(args.body, args.file)
    if body is None:
        _die("challenges-create needs --body or --file with the challenge payload")
    _ok(_hit_post(args, "/api/chat/html-challenges", body=body, timeout=args.timeout))
    return 0


