# ---------------------------------------------------------------------------
# Setup / install endpoints
# ---------------------------------------------------------------------------


def _poll_install(args: argparse.Namespace, status_path: str, *, label: str) -> int:
    deadline = time.time() + args.timeout
    last_phase = ""
    while time.time() < deadline:
        code, payload = _request("GET", f"{_base_url(args)}{status_path}", timeout=10.0)
        if code != 200 or not isinstance(payload, dict):
            time.sleep(2)
            continue
        phase = payload.get("phase") or ""
        if phase != last_phase:
            print(f"[{label}] phase: {phase}", file=sys.stderr, flush=True)
            last_phase = phase
        if payload.get("done"):
            _ok(payload)
            return 0 if not payload.get("error") else 1
        time.sleep(2)
    _die(f"{label} timed out")
    return 1


def cmd_mtplx_install(args: argparse.Namespace) -> int:
    _hit_post(args, "/api/setup/install-mtplx", body={}, timeout=30.0)
    if not args.wait:
        _ok(_hit_get(args, "/api/setup/install-mtplx/status", timeout=10.0))
        return 0
    return _poll_install(args, "/api/setup/install-mtplx/status", label="mtplx")


def cmd_mtplx_status(args: argparse.Namespace) -> int:
    _ok(_hit_get(args, "/api/setup/mtplx-status", timeout=10.0))
