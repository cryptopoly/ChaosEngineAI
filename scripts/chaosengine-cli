def cmd_cache_preview(args: argparse.Namespace) -> int:
    query = f"?ref={urllib.parse.quote(args.ref)}"
    if args.context is not None:
        query += f"&context={args.context}"
    if args.cache_strategy:
        query += f"&cacheStrategy={urllib.parse.quote(args.cache_strategy)}"
    if args.cache_bits is not None:
        query += f"&cacheBits={args.cache_bits}"
    code, payload = _request("GET", f"{_base_url(args)}/api/cache/preview{query}", timeout=15.0)
    if code != 200:
        _die(f"cache-preview failed: {payload}")
    _ok(payload)
    return 0


