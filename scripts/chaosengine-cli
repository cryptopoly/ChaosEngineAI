def cmd_server_logs(args: argparse.Namespace) -> int:
    """Stream server log SSE until interrupted."""
    for event in _stream(f"{_base_url(args)}/api/server/logs/stream", body=None, method="GET", timeout=args.timeout):
        sys.stdout.write(json.dumps(event) + "\n")
        sys.stdout.flush()
    return 0


# ---------------------------------------------------------------------------
# Image generation
# ---------------------------------------------------------------------------


def cmd_image_generate(args: argparse.Namespace) -> int:
    if args.body or args.file:
        body = _load_body_arg(args.body, args.file)
    else:
        body = {
            "prompt": args.prompt, "modelId": args.model,
            "steps": args.steps, "width": args.width, "height": args.height,
            "guidance": args.guidance, "seed": args.seed,
            "negativePrompt": args.negative,
        }
        # Strip Nones — backend has its own defaults
        body = {k: v for k, v in body.items() if v is not None}
    if args.stream:
        for event in _stream(f"{_base_url(args)}/api/images/generate", body, timeout=args.timeout):
            sys.stdout.write(json.dumps(event) + "\n")
            sys.stdout.flush()
        return 0
    _ok(_hit_post(args, "/api/images/generate", body=body, timeout=args.timeout))
    return 0


def cmd_image_progress(args: argparse.Namespace) -> int:
    _ok(_hit_get(args, "/api/images/progress", timeout=5.0))
    return 0


def cmd_image_cancel(args: argparse.Namespace) -> int:
