    sub.add_parser("diagnostics-snapshot").set_defaults(func=cmd_diagnostics_snapshot)
    s = sub.add_parser("diagnostics-log-tail")
    s.add_argument("--lines", type=int, default=200); s.set_defaults(func=cmd_diagnostics_log_tail)
    sub.add_parser("diagnostics-reextract").set_defaults(func=cmd_diagnostics_reextract)

    # -- Misc --
    sub.add_parser("gpu-status").set_defaults(func=cmd_gpu_status)
    sub.add_parser("metrics-gpu").set_defaults(func=cmd_metrics_gpu)
    s = sub.add_parser("cache-preview"); s.add_argument("ref"); s.add_argument("--context", type=int, default=None); s.add_argument("--cache-strategy", default=None); s.add_argument("--cache-bits", type=int, default=None); s.set_defaults(func=cmd_cache_preview)
    sub.add_parser("prompts-list").set_defaults(func=cmd_prompts_list)
    s = sub.add_parser("prompts-create"); s.add_argument("--body", default=None); s.add_argument("--file", default=None); s.set_defaults(func=cmd_prompts_create)
