    s = sub.add_parser("video-download-cancel"); s.add_argument("repo"); s.set_defaults(func=cmd_video_download_cancel)
    s = sub.add_parser("video-download-delete"); s.add_argument("repo"); s.set_defaults(func=cmd_video_download_delete)

    # -- Output artifacts --
    s = sub.add_parser("image-output-get"); s.add_argument("artifact_id"); s.set_defaults(func=cmd_image_output_get)
    s = sub.add_parser("image-output-delete"); s.add_argument("artifact_id"); s.set_defaults(func=cmd_image_output_delete)
    s = sub.add_parser("video-output-get"); s.add_argument("artifact_id"); s.set_defaults(func=cmd_video_output_get)
    s = sub.add_parser("video-output-file"); s.add_argument("artifact_id"); s.add_argument("--out", default=None); s.set_defaults(func=cmd_video_output_file)
    s = sub.add_parser("video-output-delete"); s.add_argument("artifact_id"); s.set_defaults(func=cmd_video_output_delete)

    # -- Workspaces management --
    s = sub.add_parser("workspaces-rename"); s.add_argument("workspace_id"); s.add_argument("--name", default=None); s.add_argument("--body", default=None); s.add_argument("--file", default=None); s.set_defaults(func=cmd_workspaces_rename)
    s = sub.add_parser("workspaces-delete"); s.add_argument("workspace_id"); s.set_defaults(func=cmd_workspaces_delete)
    s = sub.add_parser("workspaces-document-delete"); s.add_argument("workspace_id"); s.add_argument("doc_id"); s.set_defaults(func=cmd_workspaces_document_delete)

    # -- Session extras --
    s = sub.add_parser("session-rename"); s.add_argument("session_id"); s.add_argument("--title", default=None); s.add_argument("--body", default=None); s.add_argument("--file", default=None); s.set_defaults(func=cmd_session_rename)
    s = sub.add_parser("session-document-upload"); s.add_argument("session_id"); s.add_argument("--body", default=None); s.add_argument("--file", default=None); s.set_defaults(func=cmd_session_document_upload)
    s = sub.add_parser("session-document-delete"); s.add_argument("session_id"); s.add_argument("doc_id"); s.set_defaults(func=cmd_session_document_delete)

    # -- Misc --
    s = sub.add_parser("image-preload"); s.add_argument("--model", default=None); s.add_argument("--body", default=None); s.add_argument("--file", default=None); s.add_argument("--timeout", type=float, default=600.0); s.set_defaults(func=cmd_image_preload)
    s = sub.add_parser("settings-storage-set"); s.add_argument("--body", default=None); s.add_argument("--file", default=None); s.set_defaults(func=cmd_settings_storage_set)
    s = sub.add_parser("settings-storage-move"); s.add_argument("--destination", default=None); s.add_argument("--body", default=None); s.add_argument("--file", default=None); s.add_argument("--timeout", type=float, default=3600.0); s.set_defaults(func=cmd_settings_storage_move)
    sub.add_parser("settings-storage-move-status").set_defaults(func=cmd_settings_storage_move_status)
    sub.add_parser("video-longlive").set_defaults(func=cmd_video_longlive)
    sub.add_parser("video-mlx-runtime").set_defaults(func=cmd_video_mlx_runtime)
    sub.add_parser("v1-models").set_defaults(func=cmd_v1_models)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return int(args.func(args) or 0)


if __name__ == "__main__":
    sys.exit(main())
