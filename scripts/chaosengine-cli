# ---------------------------------------------------------------------------
# Argument parser
# ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="chaosengine-cli",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--host", default=_DEFAULT_HOST)
    parser.add_argument("--port", type=int, default=_DEFAULT_PORT)
    sub = parser.add_subparsers(dest="cmd", required=True)

    # -- Generic --
    s = sub.add_parser("call", help="Generic HTTP dispatcher — every route reachable.")
    s.add_argument("method", choices=["GET", "POST", "PUT", "DELETE", "PATCH",
                                       "get", "post", "put", "delete", "patch"])
    s.add_argument("path")
    s.add_argument("--body", help="Inline JSON body.")
    s.add_argument("--file", help="Read body from file (or '-' for stdin).")
    s.add_argument("--query", nargs="*", help="Query params, format key=value.")
    s.add_argument("--stream", action="store_true", help="Treat response as SSE.")
    s.add_argument("--timeout", type=float, default=120.0)
    s.set_defaults(func=cmd_call)

    s = sub.add_parser("routes", help="List backend routes from /openapi.json.")
    s.add_argument("--filter", help="Filter by path prefix, e.g. /api/images")
    s.add_argument("--method", help="Filter by HTTP method.")
    s.set_defaults(func=cmd_routes)

    s = sub.add_parser("openapi", help="Dump full OpenAPI schema.")
    s.set_defaults(func=cmd_openapi)

    s = sub.add_parser("serve", help="Start backend in foreground.")
    s.set_defaults(func=cmd_serve)

    # -- Runtime --
    s = sub.add_parser("status", help="Workspace + runtime snapshot.")
    s.set_defaults(func=cmd_status)
    sub.add_parser("health", help="Backend health probe.").set_defaults(func=cmd_health)
    sub.add_parser("runtime", help="Current runtime info.").set_defaults(func=cmd_runtime)

    # -- Models --
