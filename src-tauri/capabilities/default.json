{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the ChaosEngineAI desktop window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "x-apple.systempreferences:com.apple.preference.security?Privacy_Microphone" },
        { "url": "ms-settings:privacy-microphone" }
      ]
    },
    "updater:default",
    "process:default"
  ]
}
